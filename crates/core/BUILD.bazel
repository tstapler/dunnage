load("@crates//:defs.bzl", "all_crate_deps")
load("//build:defs.bzl", "dc_integration_tests", "dc_library", "dc_manifest_env", "dc_unit_and_doc_tests")

exports_files(["Cargo.toml"])

dc_manifest_env()

SCAN = ["//crates/scan:scan"]

dc_library(
    name = "core",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "disk_cleanup_core",
    # Cargo feature test-support: the shipped target only has it behind the explicit taint flag (see //build).
    crate_features = select({
        "//build:test_support_on": ["test-support"],
        "//conditions:default": [],
    }),
    deps = SCAN + all_crate_deps(normal = True),
    proc_macro_deps = all_crate_deps(proc_macro = True),
    ts_features = ["test-support"],
)

TEST_DATA = ["//:repo_files"]

dc_unit_and_doc_tests(
    name = "core",
    crate = ":core_ts",
    data = TEST_DATA,
    # rules_rust's rustdoc --test ignores crate_features, so the doc-tests run against the shipped (feature-off)
    # library. Cargo's run never sees `NoForTestsWithoutFeature` (the self dev-dependency turns the feature on);
    # here its compile_fail check of "no ApplyToken::for_tests without the feature" runs for real.
    doc_crate = ":core",
    deps = all_crate_deps(normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
)

dc_integration_tests(
    crate = "core",
    data = TEST_DATA,
    compile_data = glob(["src/**/*.rs"]),
    deps = [":core_ts"] + SCAN + all_crate_deps(normal = True) + all_crate_deps(normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro = True) + all_crate_deps(proc_macro_dev = True),
)

filegroup(
    name = "all_files",
    srcs = glob(["**"], exclude = ["BUILD.bazel", "manifest_env.txt"]),
    visibility = ["//visibility:public"],
)
