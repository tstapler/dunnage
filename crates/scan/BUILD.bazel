load("@crates//:defs.bzl", "all_crate_deps")
load("//build:defs.bzl", "dc_integration_tests", "dc_library", "dc_manifest_env", "dc_unit_and_doc_tests")

exports_files(["Cargo.toml"])

dc_manifest_env()

TESTDATA = glob(["tests/**"], exclude = ["tests/**/*.rs"], allow_empty = True)

dc_library(
    name = "scan",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "disk_cleanup_scan",
    deps = all_crate_deps(normal = True),
    proc_macro_deps = all_crate_deps(proc_macro = True),
    with_ts = False,
)

dc_unit_and_doc_tests(
    name = "scan",
    crate = ":scan",
    data = TESTDATA,
    deps = all_crate_deps(normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
)

dc_integration_tests(
    crate = "scan",
    per_test = {
        # Clears the save gate from a second thread while the write runs; on a saturated machine the write is done
        # first and the test sees no abort (failed once in 3 full runs at load 30+, 0 of 6 alone).
        "stream_cancel": {"flaky": True},
    },
    deps = [":scan"] + all_crate_deps(normal = True) + all_crate_deps(normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro = True) + all_crate_deps(proc_macro_dev = True),
    rustc_env = {},
)

filegroup(
    name = "all_files",
    srcs = glob(["**"], exclude = ["BUILD.bazel", "manifest_env.txt"]),
    visibility = ["//visibility:public"],
)

# adapters/tests/explore_paint.rs includes this module with #[path].
filegroup(
    name = "stream_common",
    srcs = glob(["tests/stream_common/**"]),
    visibility = ["//visibility:public"],
)
